# This file is managed by makeOutOfStoreSymlink and is thus writable
# This is mainly a hack to allow devpod to write its Host configuration to the ~/.ssh/config file

AddKeysToAgent yes

# DevPod Start panda-prosthesis-superbuild.devpod
Host panda-prosthesis-superbuild.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/nix/store/drdcgg1rxcgir1y2swrpavjbhkycs8kv-devpod-0.6.15/bin/devpod" ssh --stdio --context default --user vscode panda-prosthesis-superbuild --workdir "/home/vscode/superbuild"
  User vscode
# DevPod End panda-prosthesis-superbuild.devpod
Host *
  IdentityFile ~/.ssh/yubikey.pub

Host arntanguy.fr
  User ubuntu
  # Force SSH to use the agent and ignore the file system
  IdentitiesOnly yes
