Host arntanguy.fr
  User ubuntu
  # Force SSH to use the agent and ignore the file system
  IdentitiesOnly yes
  # Syncthing port forwarding
  # On the arntanguy.fr server syncthing gui is bound to 127.0.0.1:8384
  # We bind the local port 8384 to it through ssh-forwarding
  # Do not expose port 8384 on the server
  LocalForward 8384 127.0.0.1:8384

Host rhps1
  User rhps1user

