# This file is managed by makeOutOfStoreSymlink and is thus writable
# This is mainly a hack to allow devpod to write its Host configuration to the ~/.ssh/config file

AddKeysToAgent yes

# DevPod Start mc-rtc-superbuild-jammy.devpod
Host mc-rtc-superbuild-jammy.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/nix/store/z224n0gqnqp69q7kn0gdpks7rhzr5r0a-devpod-0.6.15/bin/devpod" ssh --stdio --context default --user vscode mc-rtc-superbuild-jammy --workdir "/home/vscode/superbuild"
  User vscode
# DevPod End mc-rtc-superbuild-jammy.devpod
